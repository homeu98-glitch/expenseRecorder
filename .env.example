## OCR provider keys

# OpenRouter（主要 provider）
# key 必須以 sk-or- 開頭，去 https://openrouter.ai/keys 申請
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHEAP_MODEL=google/gemini-2.5-flash
OPENROUTER_STRONG_MODEL=google/gemini-2.5-pro
OPENROUTER_CHEAP_MAX_TOKENS=600
OPENROUTER_STRONG_MAX_TOKENS=1200

# Qwen / Alibaba（保留做 fallback，額度用完可留空）
ALIBABA_API_KEY=replace-with-qwen-key
ALIBABA_BASE_URL=https://ws-vf1nz0yy8t6dp30m.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Gemini（保留做 fallback）
GEMINI_API_KEY=replace-with-gemini-key

## OCR fallback order
# 語法：openrouter-cheap / openrouter-strong / openrouter:<model-id> / gemini-flash / gemini-strong / qwen-cheap / qwen-strong
# 建議：OpenRouter 打頭，其餘留作 fallback
OCR_FALLBACK_ORDER=openrouter-cheap,gemini-flash,openrouter-strong,qwen-strong

## Qwen model config
QWEN_CHEAP_MODEL=qwen-vl-plus
QWEN_STRONG_MODEL=qwen-vl-plus
QWEN_CHEAP_MAX_TOKENS=600
QWEN_STRONG_MAX_TOKENS=1200

## Gemini model config
GEMINI_CHEAP_MODEL=gemini-1.5-flash
GEMINI_STRONG_MODEL=gemini-1.5-pro

## Ledger 買貨報表 API（HMAC，專用，唔可重用 offline-report / webhook / SSO / pepper）
## 真值只落部署平台 env（Vercel/Glitch），唔 commit 入 git。
LEDGER_PURCHASE_REPORT_HMAC_SECRET=
