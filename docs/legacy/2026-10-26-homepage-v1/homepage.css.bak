
/* ══════════════════════════════════════════════
   澳門會員通 · 官網首頁（/homepage）
   樣式：暖白奶油底、柔化品牌色、零純黑
   class 一律用 hp- 前綴，避免與 globals.css / Tailwind 撞名
   ══════════════════════════════════════════════ */
:root{
  /* 底色：暖白 / 奶油系（取代冷灰） */
  --cream:#fdfbf8;
  --sand:#f9f4ed;
  --linen:#f3ece1;
  --shell:#ffffff;

  /* 文字：暖調（唔用純黑 #0f172a） */
  --ink:#3d3833;
  --ink2:#544e47;
  --slate:#8a8177;
  --mute:#b4aa9e;

  /* 邊框：暖灰 */
  --line:#ece4d7;
  --line2:#ddd2c2;

  /* 品牌色：柔化版（保留藍 / 青 / 綠辨識度） */
  --blue:#5f8fd4;
  --blue-d:#4d7cbe;
  --blue-l:#e9f1fb;
  --cyan:#5cb6c8;
  --teal:#4fb3a8;
  --green:#68bd94;
  --green-d:#4a9c76;
  --green-l:#e6f6ee;
  --amber:#e3a463;
  --amber-l:#fdf1e2;
  --peach:#efae91;
  --peach-l:#fdeee6;
  --rose:#dd938f;
  --rose-l:#fceeec;
  --violet:#9a8fd0;
  --violet-l:#f0eefb;
  --indigo:#7d8bd3;
  --indigo-l:#eef0fb;

  /* 主 CTA：柔和珊瑚橙（取代高飽和玫瑰紅） */
  --cta:linear-gradient(135deg,#f0967a,#f2ac74,#f4c886);
  --cta-shadow:0 10px 24px rgba(240,150,122,.26);
}
.hp-root{
  overflow-x:clip;
  width:100vw;
  margin-left:calc(50% - 50vw);
  background:var(--cream);
  font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,-apple-system,sans-serif;
  color:var(--ink);-webkit-font-smoothing:antialiased;
}

/* ── 評審工具列（唔屬產品介面） ─────────────── */
/* ── 固定畫布 ─────────────────────────────── */
.hp-wrap{max-width:1180px;margin:0 auto;padding:0 24px}

.hp-sec-pad{padding:76px 0}

/* ── 通用 ─────────────────────────────────── */
.hp-eyebrow{
  display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:900;letter-spacing:.14em;
  border-radius:999px;padding:8px 16px;border:1px solid var(--line);background:var(--shell);color:var(--slate);
}
.hp-h2{font-size:40px;font-weight:900;letter-spacing:-.02em;line-height:1.18}
.hp-h3{font-size:17px;font-weight:900;line-height:1.4}
.hp-lead{font-size:16.5px;color:var(--slate);line-height:1.78}
.hp-mut{color:var(--mute)}
.hp-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:16px;
  font-weight:900;font-size:15px;padding:15px 26px;border:0;cursor:pointer;text-decoration:none;
  transition:transform .28s cubic-bezier(.22,1,.36,1),box-shadow .28s ease,filter .28s ease,background .28s ease;
}
.hp-btn:hover{transform:translateY(-2px);filter:brightness(1.04)}
.hp-btn:active{transform:translateY(0) scale(.985)}
.hp-btn-cta{background:var(--cta);color:#fff;box-shadow:var(--cta-shadow)}
.hp-btn-cta:hover{box-shadow:0 16px 32px rgba(240,150,122,.34)}
.hp-btn-dark{background:var(--ink);color:#fff}
.hp-btn-white{background:var(--shell);color:var(--ink);border:1px solid var(--line)}
.hp-btn-blue{background:var(--blue);color:#fff;box-shadow:0 10px 24px rgba(95,143,212,.24)}
.hp-btn-line{background:var(--shell);color:var(--blue-d);border:1.5px solid #cddef3}
.hp-btn-sm{padding:12px 20px;font-size:14px;border-radius:14px}
.hp-ico{
  width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;
  font-size:26px;line-height:1;border:1px solid var(--line);background:var(--sand);flex:none;
}
.hp-tag-new{
  display:inline-flex;align-items:center;gap:5px;background:var(--rose);color:#fff;
  font-size:11px;font-weight:900;border-radius:999px;padding:4px 10px;letter-spacing:.06em;
}
.hp-tag-soon{background:var(--amber-l);color:#9a6a2e;border:1px solid #f0d9b4}
.hp-card{background:var(--shell);border:1px solid var(--line);border-radius:22px;padding:26px}
.hp-grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
.hp-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.hp-grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}

/* ── 動態：進場 / 浮起 / 呼吸 ───────────────── */
.hp-reveal{opacity:0;transform:translateY(26px);
  transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1)}
.hp-reveal.hp-in{opacity:1;transform:translateY(0)}
.hp-d1{transition-delay:.07s}.hp-d2{transition-delay:.14s}.hp-d3{transition-delay:.21s}
.hp-d4{transition-delay:.28s}.hp-d5{transition-delay:.35s}.hp-d6{transition-delay:.42s}

.hp-hoverable{transition:transform .38s cubic-bezier(.22,1,.36,1),box-shadow .38s ease,border-color .38s ease}
.hp-hoverable:hover{transform:translateY(-5px);box-shadow:0 20px 44px rgba(61,56,51,.10);border-color:var(--line2)}

@keyframes drift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes hue{0%{background-position:0% 50%}100%{background-position:200% 50%}}
@keyframes pulseDot{0%,100%{opacity:.45;transform:scale(1)}50%{opacity:1;transform:scale(1.18)}}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes glowRing{0%,100%{box-shadow:0 18px 46px rgba(240,150,122,.12)}50%{box-shadow:0 22px 54px rgba(240,150,122,.26)}}
@keyframes shimmer{0%{background-position:-160% 0}100%{background-position:260% 0}}

.hp-ico{animation:bob 5s ease-in-out infinite}
.hp-mer-card:nth-child(2n) .hp-ico,.hp-cust-card:nth-child(2n) .hp-ico,.hp-hw-card:nth-child(2n) .hp-ico{animation-delay:.9s}
.hp-mer-card:nth-child(3n) .hp-ico,.hp-cust-card:nth-child(3n) .hp-ico,.hp-hw-card:nth-child(3n) .hp-ico{animation-delay:1.7s}
.hp-dot.hp-on{animation:pulseDot 2.4s ease-in-out infinite}
.hp-callout-quote{animation:floaty 6.5s ease-in-out infinite}
.hp-plan.hp-hot{animation:glowRing 5s ease-in-out infinite}

/* ── NAV ──────────────────────────────────── */
.hp-nav{position:sticky;top:0;background:rgba(253,251,248,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);z-index:20}
.hp-nav-in{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:22px;align-items:center;padding:14px 0}
.hp-brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit}
.hp-brand-mark{
  width:46px;height:46px;border-radius:15px;background:linear-gradient(135deg,var(--blue),var(--green));
  color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;
  transition:transform .4s cubic-bezier(.22,1,.36,1);
}
.hp-brand:hover .hp-brand-mark{transform:rotate(-6deg) scale(1.06)}
.hp-brand-t{font-size:17px;font-weight:900;line-height:1.15;display:block}
.hp-brand-s{font-size:10px;font-weight:800;color:var(--mute);letter-spacing:.16em;display:block}
.hp-navmenu{display:flex;align-items:center;gap:26px;font-size:14px;font-weight:900;color:#5c554e;justify-content:center}
.hp-navmenu a{color:inherit;text-decoration:none;position:relative;padding-bottom:3px}
.hp-navmenu a::after{
  content:"";position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:2px;
  background:var(--cta);transform:scaleX(0);transform-origin:left;transition:transform .32s cubic-bezier(.22,1,.36,1);
}
.hp-navmenu a:hover::after{transform:scaleX(1)}

/* ── HERO ─────────────────────────────────── */
.hp-hero{background:
  radial-gradient(circle at 16% 10%,rgba(95,143,212,.11),transparent 38%),
  radial-gradient(circle at 84% 16%,rgba(92,182,200,.10),transparent 36%),
  radial-gradient(circle at 78% 88%,rgba(104,189,148,.11),transparent 38%),
  radial-gradient(circle at 26% 92%,rgba(239,174,145,.10),transparent 34%),
  linear-gradient(180deg,#fdfbf8,#f7f1e8);
  background-size:170% 170%;animation:drift 28s ease-in-out infinite;}
.hp-hero-in{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:52px;align-items:center;padding:60px 0 70px}
.hp-hero h1{font-size:56px;font-weight:900;line-height:1.06;letter-spacing:-.03em;margin-top:20px}
.hp-hero h1 em{
  font-style:normal;display:block;
  background:linear-gradient(90deg,var(--blue),var(--cyan),var(--green),var(--blue));
  background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;
  animation:hue 10s linear infinite;
}
.hp-hero-lead{margin-top:18px;font-size:17px;line-height:1.8;color:#6b635b;max-width:520px}
.hp-slogans{display:grid;gap:10px;margin-top:22px}
.hp-slogan{
  background:rgba(255,255,255,.86);border:1px solid #fff;border-radius:15px;padding:12px 16px;
  font-size:14px;font-weight:800;color:#5c554e;box-shadow:0 6px 18px rgba(61,56,51,.05);
  transition:transform .32s cubic-bezier(.22,1,.36,1),box-shadow .32s ease;
}
.hp-slogan:hover{transform:translateX(6px);box-shadow:0 10px 24px rgba(61,56,51,.09)}
.hp-hero-cta{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap}
.hp-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:26px}
.hp-metric{
  background:rgba(255,255,255,.86);border:1px solid #fff;border-radius:16px;padding:14px;
  box-shadow:0 6px 18px rgba(61,56,51,.05);
  transition:transform .32s cubic-bezier(.22,1,.36,1),box-shadow .32s ease;
}
.hp-metric:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(61,56,51,.09)}
.hp-metric b{display:block;font-size:15px;font-weight:900}
.hp-metric span{display:block;font-size:11.5px;color:var(--slate);margin-top:3px;line-height:1.5}

/* 手機示意（白框，輕盈版） */
.hp-phone{
  width:238px;border-radius:34px;background:#fffdfa;padding:10px;
  box-shadow:0 26px 60px rgba(61,56,51,.16),0 0 0 1px var(--line);
  margin:0 auto;position:relative;
}
.hp-phone::after{
  content:"";position:absolute;top:17px;left:50%;transform:translateX(-50%);
  width:74px;height:16px;border-radius:999px;background:#ece4d7;
}
.hp-phone-scr{border-radius:26px;background:var(--shell);overflow:hidden;height:456px;display:flex;flex-direction:column;border:1px solid var(--line);position:relative}
.hp-p-top{background:linear-gradient(135deg,var(--blue),var(--cyan));color:#fff;padding:30px 16px 14px}
.hp-p-top b{font-size:14px;font-weight:900;display:block}
.hp-p-top span{font-size:11px;opacity:.92}
.hp-p-body{flex:1;padding:12px;display:grid;gap:9px;align-content:start;background:var(--sand)}
.hp-p-row{
  background:var(--shell);border:1px solid var(--line);border-radius:12px;padding:10px 12px;
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;
}
.hp-p-row b{font-size:12.5px;font-weight:900;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hp-p-row i{font-size:10.5px;color:var(--mute);font-style:normal}
.hp-p-row u{font-size:12.5px;font-weight:900;color:var(--blue-d);text-decoration:none}
.hp-p-btn{background:var(--cta);color:#fff;border-radius:12px;text-align:center;font-weight:900;font-size:13px;padding:11px}
.hp-p-note{font-size:11.5px;color:var(--slate);text-align:center}
.hp-slide-dots{display:flex;align-items:center;gap:7px;justify-content:center;margin-top:16px}
.hp-dot{width:8px;height:8px;border-radius:999px;background:#dfd6c9}
.hp-dot.hp-on{width:26px;background:var(--blue)}
.hp-hero-side-note{
  margin-top:16px;display:flex;align-items:center;justify-content:center;gap:10px;
  font-size:12.5px;font-weight:800;color:var(--slate);
}

/* ── 分流 ─────────────────────────────────── */
.hp-choose{background:var(--cream)}
.hp-choose-head{text-align:center;margin-bottom:34px}
.hp-choose-head .hp-h2{margin-top:16px}
.hp-choose-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.hp-choose-card{border-radius:28px;padding:34px;position:relative;overflow:hidden;display:flex;flex-direction:column;
  transition:transform .4s cubic-bezier(.22,1,.36,1),box-shadow .4s ease}
.hp-choose-card:hover{transform:translateY(-6px);box-shadow:0 24px 54px rgba(61,56,51,.11)}
.hp-choose-cust{background:linear-gradient(150deg,#eef4fd,#f0f8f5);border:1px solid #dbe8f8}
.hp-choose-mer{background:linear-gradient(150deg,#fdf1e6,#fbeee8);border:1px solid #f2ddc9}
.hp-choose-role{
  display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:7px 15px;
  font-size:12px;font-weight:900;letter-spacing:.1em;align-self:flex-start;
}
.hp-choose-cust .hp-choose-role{background:var(--shell);color:var(--blue-d);border:1px solid #dbe8f8}
.hp-choose-mer .hp-choose-role{background:var(--shell);color:#b5754a;border:1px solid #f2ddc9}
.hp-choose-card h3{font-size:29px;font-weight:900;margin-top:16px;letter-spacing:-.01em}
.hp-choose-card p{margin-top:10px;font-size:14.5px;line-height:1.75}
.hp-choose-cust p{color:#6b635b}
.hp-choose-mer p{color:#7a6b5e}
.hp-choose-list{display:grid;gap:10px;margin-top:20px}
.hp-choose-li{display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:700;color:#5c554e}
.hp-choose-li span.hp-chk{
  width:22px;height:22px;border-radius:999px;display:flex;align-items:center;justify-content:center;
  font-size:12px;flex:none;background:var(--shell);color:var(--green-d);border:1px solid #dbe8f8;
}
.hp-choose-mer .hp-choose-li span.hp-chk{background:var(--shell);border-color:#f2ddc9;color:#c98a5f}
.hp-choose-cta{margin-top:auto;padding-top:26px;display:flex;gap:10px}

/* ── 客人專區 ─────────────────────────────── */
.hp-cust{background:linear-gradient(180deg,#fdfbf8,#f9f7f2)}
.hp-lane-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;margin-bottom:34px}
.hp-cust .hp-eyebrow{background:var(--blue-l);border-color:#dbe8f8;color:var(--blue-d)}
.hp-cust .hp-h2{margin-top:14px}
.hp-cust-card{border:1px solid #e4ecf6;background:var(--shell);border-radius:22px;padding:24px}
.hp-cust-card .hp-ico{background:var(--blue-l);border-color:#dbe8f8}
.hp-cust-card .hp-h3{margin-top:16px;font-size:17.5px}
.hp-cust-card p{margin-top:8px;font-size:14px;color:var(--slate);line-height:1.7}
.hp-cust-strip{
  margin-top:26px;background:linear-gradient(90deg,#eef4fd,#eef8f6,#f2faf6);border:1px solid #dbe8f8;
  border-radius:22px;padding:22px 26px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:center;
}
.hp-cust-strip b{font-size:17px;font-weight:900}
.hp-cust-strip span{display:block;font-size:13.5px;color:var(--slate);margin-top:5px}

/* ── 商家專區 ─────────────────────────────── */
.hp-mer{background:linear-gradient(180deg,#f9f7f2,#fdfbf8)}
.hp-mer .hp-eyebrow{background:var(--green-l);border-color:#cfeadd;color:var(--green-d)}
.hp-mer .hp-h2{margin-top:14px}
.hp-bizline{display:flex;gap:10px;margin:26px 0}
.hp-biztab{
  display:inline-flex;align-items:center;gap:9px;border-radius:16px;padding:13px 22px;font-size:15px;font-weight:900;
  border:1px solid var(--line);background:var(--shell);color:#6b635b;cursor:pointer;
  transition:transform .3s cubic-bezier(.22,1,.36,1),background .3s ease,box-shadow .3s ease,color .3s ease;
}
.hp-biztab:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(61,56,51,.08)}
.hp-biztab.hp-on{background:linear-gradient(135deg,#5c5550,#4a423b);border-color:#4a423b;color:#fff;box-shadow:0 12px 26px rgba(74,66,59,.22)}
.hp-biztab u{
  font-size:10.5px;font-weight:900;text-decoration:none;border-radius:999px;padding:3px 8px;
  background:var(--amber-l);color:#9a6a2e;
}
.hp-biztab.hp-on u{background:rgba(253,241,226,.22);color:#f5d6ac}
.hp-bizpanel{display:none}
.hp-bizpanel.hp-on{display:block}
.hp-mer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.hp-mer-card{border:1px solid var(--line);background:var(--shell);border-radius:20px;padding:22px;position:relative}
.hp-mer-card .hp-ico{background:var(--sand);border-color:var(--line)}
.hp-mer-card .hp-h3{margin-top:14px;font-size:16.5px}
.hp-mer-card p{margin-top:7px;font-size:13.5px;color:var(--slate);line-height:1.68}
.hp-mer-card .hp-tag-new,.hp-mer-card .hp-tag-soon{position:absolute;top:20px;right:20px}
.hp-mer-foot{
  margin-top:22px;border:1px dashed var(--line2);border-radius:20px;padding:20px 24px;
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;background:var(--shell);
}
.hp-mer-foot b{font-size:15.5px;font-weight:900}
.hp-mer-foot span{display:block;font-size:13px;color:var(--slate);margin-top:5px}

/* ── 打印 ─────────────────────────────────── */
.hp-print-sec{background:var(--cream)}
.hp-pr-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:30px}
.hp-pr-card{border:1px solid var(--line);border-radius:22px;padding:24px;display:flex;flex-direction:column;height:100%;background:var(--shell)}
.hp-pr-card .hp-h3{margin-top:16px;font-size:17px}
.hp-pr-card p{margin-top:8px;font-size:13.5px;color:var(--slate);line-height:1.7}
.hp-pr-badge{
  align-self:flex-start;margin-top:16px;font-size:11.5px;font-weight:900;border-radius:999px;padding:5px 12px;
  background:var(--green-l);color:var(--green-d);border:1px solid #cfeadd;
}
.hp-pr-badge.hp-opt{background:var(--amber-l);color:#9a6a2e;border-color:#f0d9b4}
.hp-callout{
  margin-top:26px;background:linear-gradient(90deg,#eef8f3,#eef6f8);border:1px solid #d3ebdf;
  border-radius:22px;padding:24px 28px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:center;
}
.hp-callout b{font-size:16.5px;font-weight:900;display:block}
.hp-callout span{display:block;font-size:14px;color:#6b635b;margin-top:8px;line-height:1.72}
.hp-callout-quote{
  background:var(--shell);border:1px solid #d3ebdf;border-radius:16px;padding:16px 20px;font-size:14px;
  font-weight:900;color:var(--green-d);white-space:nowrap;text-align:center;line-height:1.6;
}

/* ── 硬件 ─────────────────────────────────── */
.hp-hw{background:linear-gradient(180deg,#f9f7f2,#fdfbf8)}
.hp-hw-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:30px}
.hp-hw-card{border:1px solid var(--line);border-radius:20px;padding:22px;background:var(--shell);display:flex;flex-direction:column;height:100%}
.hp-hw-card .hp-ico{background:var(--indigo-l);border-color:#e0e4f8}
.hp-hw-card b{display:block;font-size:15.5px;font-weight:900;margin-top:14px}
.hp-hw-card span{display:block;font-size:13px;color:var(--slate);margin-top:7px;line-height:1.65}
.hp-hw-strip{
  margin-top:24px;border:1px solid #e0e4f8;background:var(--indigo-l);border-radius:20px;padding:20px 26px;
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;align-items:center;
}
.hp-hw-strip b{font-size:16px;font-weight:900;display:block}
.hp-hw-strip span{display:block;font-size:13.5px;color:#6b635b;margin-top:7px;line-height:1.7}

/* ── 重點功能展示（改淺色） ─────────────────── */
.hp-show{background:linear-gradient(180deg,#f7f1e8,#fdfbf8);color:var(--ink)}
.hp-show .hp-eyebrow{background:var(--shell);border-color:var(--line);color:var(--slate)}
.hp-show .hp-h2{margin-top:14px}
.hp-show .hp-lead{color:var(--slate)}
.hp-show-item{
  display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:40px;align-items:center;
  padding:44px 0;border-top:1px solid var(--line);
}
.hp-show-item:first-of-type{border-top:0;margin-top:30px;padding-top:34px}
.hp-show-no{
  display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:900;letter-spacing:.14em;
  color:#b5754a;background:var(--peach-l);border:1px solid #f4d8c9;border-radius:999px;padding:7px 14px;
}
.hp-show-item h3{font-size:31px;font-weight:900;margin-top:16px;letter-spacing:-.01em;line-height:1.25}
.hp-show-item p{margin-top:12px;font-size:15px;color:#6b635b;line-height:1.8}
.hp-show-list{display:grid;gap:9px;margin-top:18px}
.hp-show-li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:#544e47;font-weight:700}
.hp-show-li em{color:var(--green-d);font-style:normal}
.hp-showcmp{display:flex;gap:10px;margin-top:20px}
.hp-chipcmp{
  border-radius:14px;padding:11px 15px;font-size:12.5px;font-weight:800;line-height:1.5;
  background:var(--shell);border:1px solid var(--line);color:var(--slate);
}
.hp-chipcmp.hp-good{background:var(--green-l);border-color:#cfeadd;color:var(--green-d)}
.hp-chipcmp b{display:block;font-size:11px;letter-spacing:.1em;color:inherit;opacity:.8;margin-bottom:3px}

/* KDS 示意（淺色版） */
.hp-mock-frame{background:var(--shell);border:1px solid var(--line);border-radius:20px;padding:14px;box-shadow:0 18px 40px rgba(61,56,51,.07)}
.hp-mock-bar{display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.hp-mock-bar b{font-size:13px;font-weight:900;color:var(--ink)}
.hp-mock-badge{
  margin-left:auto;font-size:11px;font-weight:900;border-radius:999px;padding:4px 11px;
  background:var(--green-l);color:var(--green-d);border:1px solid #cfeadd;
}
.hp-mock-badge.hp-amber{background:var(--amber-l);color:#9a6a2e;border-color:#f0d9b4}
.hp-kds-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin-top:13px}
.hp-kds-col{background:var(--sand);border:1px solid var(--line);border-radius:14px;padding:11px}
.hp-kds-hd{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}
.hp-kds-hd b{font-size:12.5px;font-weight:900;color:var(--ink)}
.hp-kds-t{font-size:11px;font-weight:800;color:#9a6a2e;background:var(--amber-l);border-radius:999px;padding:3px 8px}
.hp-kds-t.hp-late{color:#b46a6a;background:var(--rose-l)}
.hp-kds-lines{display:grid;gap:6px;margin-top:9px}
.hp-kds-ln{font-size:11.5px;color:#6b635b;display:grid;grid-template-columns:26px minmax(0,1fr);gap:7px}
.hp-kds-ln span{
  text-align:center;border-radius:6px;background:var(--shell);border:1px solid var(--line);font-weight:900;
  font-size:11px;color:var(--ink2);height:18px;line-height:16px;
}
.hp-kds-btn{margin-top:11px;border-radius:10px;text-align:center;font-size:11.5px;font-weight:900;padding:8px;background:var(--blue);color:#fff}
.hp-kds-btn.hp-done{background:var(--green)}

/* 掃碼示意（柔和版：告示牌 + 手機） */
.hp-scan-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}
.hp-scan-card{
  background:var(--shell);border:1px solid var(--line);border-radius:20px;padding:20px;display:grid;gap:12px;
  justify-items:center;box-shadow:0 18px 40px rgba(61,56,51,.08);
}
.hp-scan-badge{
  width:88px;height:88px;border-radius:26px;background:linear-gradient(135deg,#eef4fd,#eef8f3);
  border:1px solid #dbe8f8;display:flex;align-items:center;justify-content:center;font-size:38px;
}
.hp-scan-card b{font-size:15px;font-weight:900;color:var(--ink)}
.hp-scan-card span{font-size:12px;color:var(--slate);text-align:center;line-height:1.6}
.hp-scanpay{
  background:var(--shell);border:1px solid var(--line);border-radius:20px;padding:18px;display:grid;
  gap:11px;align-content:start;box-shadow:0 18px 40px rgba(61,56,51,.08);
}
.hp-scanpay-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;font-size:12.5px;color:var(--slate)}
.hp-scanpay-row b{color:var(--ink);font-size:13px;font-weight:900}
.hp-scanpay-total{border-top:1px dashed var(--line2);padding-top:11px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center}
.hp-scanpay-total b{font-size:22px;font-weight:900;color:var(--ink)}
.hp-scanpay-total span{font-size:11.5px;color:var(--mute)}
.hp-scanpay-steps{display:grid;gap:8px;margin-top:12px}
.hp-scanpay-step{display:grid;grid-template-columns:22px minmax(0,1fr);gap:9px;align-items:center;font-size:11.5px;color:var(--slate)}
.hp-scanpay-step i{
  width:22px;height:22px;border-radius:999px;background:var(--green-l);color:var(--green-d);
  display:flex;align-items:center;justify-content:center;font-style:normal;font-weight:900;font-size:11px;
}
.hp-scanpay-step.hp-ok i{background:var(--green-l);color:var(--green-d)}

/* 離線示意（淺色版） */
.hp-off-panel{background:var(--shell);border:1px solid var(--line);border-radius:20px;padding:16px;display:grid;gap:11px;box-shadow:0 18px 40px rgba(61,56,51,.08)}
.hp-off-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center}
.hp-off-top b{font-size:13px;font-weight:900;color:var(--ink)}
.hp-off-pill{font-size:11px;font-weight:900;border-radius:999px;padding:4px 11px;background:var(--rose-l);color:#b46a6a;border:1px solid #f2d5d3}
.hp-off-pill.hp-ok{background:var(--green-l);color:var(--green-d);border-color:#cfeadd}
.hp-off-list{display:grid;gap:7px}
.hp-off-li{
  background:var(--sand);border:1px solid var(--line);border-radius:11px;padding:10px 12px;
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;font-size:12px;color:var(--slate);
}
.hp-off-li b{color:var(--ink2);font-size:12.5px;font-weight:800}
.hp-off-state{font-size:10.5px;font-weight:900;border-radius:999px;padding:3px 9px;background:var(--amber-l);color:#9a6a2e}
.hp-off-state.hp-ok{background:var(--green-l);color:var(--green-d)}

/* ── 線上訂單 ─────────────────────────────── */
.hp-online{background:var(--cream)}
.hp-online-box{border:1px solid var(--line);border-radius:26px;padding:30px;background:linear-gradient(180deg,#fdfbf8,#f9f7f2)}
.hp-onl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:26px}
.hp-onl-card{border:1px solid var(--line);border-radius:20px;padding:22px;background:var(--shell)}
.hp-onl-card .hp-h3{margin-top:14px;font-size:16px}
.hp-onl-card p{margin-top:7px;font-size:13.5px;color:var(--slate);line-height:1.7}
.hp-flowline{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:26px}
.hp-flow{
  background:var(--shell);border:1px solid var(--line);border-radius:14px;padding:14px;text-align:center;
  transition:transform .32s cubic-bezier(.22,1,.36,1),box-shadow .32s ease;
}
.hp-flow:hover{transform:translateY(-4px);box-shadow:0 12px 26px rgba(61,56,51,.08)}
.hp-flow b{display:block;font-size:13px;font-weight:900}
.hp-flow span{display:block;font-size:11px;color:var(--mute);margin-top:4px}

/* ── 報表 ─────────────────────────────────── */
.hp-reports{background:linear-gradient(180deg,#f9f7f2,#fdfbf8)}
.hp-rep-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:26px}
.hp-rep-card{border:1px solid var(--line);border-radius:20px;padding:22px;background:var(--shell)}
.hp-rep-card b{display:block;font-size:16px;font-weight:900;margin-top:14px}
.hp-rep-card span{display:block;font-size:13px;color:var(--slate);margin-top:7px;line-height:1.65}

/* ── 方案與定價 ───────────────────────────── */
.hp-pricing{background:var(--cream)}
.hp-plans{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:32px;align-items:stretch}
.hp-plan{
  border:1.5px solid var(--line);border-radius:24px;padding:26px 22px;background:var(--shell);
  display:flex;flex-direction:column;height:100%;position:relative;
  transition:transform .38s cubic-bezier(.22,1,.36,1),box-shadow .38s ease,border-color .38s ease;
}
.hp-plan:hover{transform:translateY(-6px);box-shadow:0 22px 48px rgba(61,56,51,.11);border-color:var(--line2)}
.hp-plan.hp-hot{border-color:#f0b9a4}
.hp-plan.hp-hot:hover{border-color:var(--peach)}
.hp-plan-tag{
  position:absolute;top:-12px;left:22px;background:var(--cta);color:#fff;font-size:11px;font-weight:900;
  border-radius:999px;padding:5px 13px;letter-spacing:.06em;box-shadow:0 8px 18px rgba(240,150,122,.28);
}
.hp-plan-name{font-size:15px;font-weight:900}
.hp-plan-sub{font-size:12px;color:var(--mute);margin-top:5px;line-height:1.55;min-height:34px}
.hp-plan-price{margin-top:14px;padding-top:14px;border-top:1px solid var(--line);display:flex;align-items:baseline;gap:6px}
.hp-plan-price b{font-size:34px;font-weight:900;letter-spacing:-.02em;line-height:1}
.hp-plan-price u{font-size:14px;font-weight:900;text-decoration:none;color:var(--slate)}
.hp-plan-price.hp-free b{color:var(--green-d)}
.hp-plan-note{font-size:11.5px;color:var(--mute);margin-top:6px}
.hp-plan-list{display:grid;gap:9px;margin-top:18px}
.hp-plan-li{display:grid;grid-template-columns:18px minmax(0,1fr);gap:9px;font-size:13px;color:#5c554e;line-height:1.6}
.hp-plan-li em{color:var(--green-d);font-style:normal;font-weight:900}
.hp-plan-li.hp-off{color:var(--mute)}
.hp-plan-li.hp-off em{color:#ddd3c6}
.hp-plan-cta{margin-top:auto;padding-top:20px}
.hp-plan-cta .hp-btn{width:100%}
.hp-why{
  margin-top:28px;background:linear-gradient(135deg,#eef8f3,#f7f4ec);border:1px solid #d3ebdf;
  border-radius:24px;padding:32px 36px;color:var(--ink);
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,420px);gap:36px;align-items:center;
}
.hp-why h3{font-size:24px;font-weight:900;line-height:1.35}
.hp-why p{margin-top:12px;font-size:14.5px;color:#6b635b;line-height:1.8}
.hp-why-cmp{display:grid;gap:12px}
.hp-why-box{border-radius:16px;padding:16px 18px;font-size:13.5px;line-height:1.6}
.hp-why-box.hp-bad{background:var(--shell);border:1px solid #f2d5d3;color:#a86a68}
.hp-why-box.hp-good{background:var(--shell);border:1px solid #cfeadd;color:var(--green-d)}
.hp-why-box b{display:block;font-size:12px;letter-spacing:.1em;margin-bottom:6px;opacity:.85}

/* ── 金流 ─────────────────────────────────── */
.hp-pay{background:linear-gradient(180deg,#f9f7f2,#fdfbf8)}
.hp-pay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:30px}
.hp-pay-card{border:1px solid var(--line);border-radius:22px;padding:28px;display:flex;flex-direction:column;height:100%;background:var(--shell)}
.hp-pay-card.hp-now{border-color:#cfeadd;background:linear-gradient(180deg,#f3faf6,#fff)}
.hp-pay-card.hp-soon{border-color:#e0e4f8;background:linear-gradient(180deg,#f3f5fd,#fff)}
.hp-pay-state{align-self:flex-start;font-size:11.5px;font-weight:900;border-radius:999px;padding:5px 13px;letter-spacing:.08em}
.hp-pay-card.hp-now .hp-pay-state{background:var(--green-l);color:var(--green-d)}
.hp-pay-card.hp-soon .hp-pay-state{background:var(--indigo-l);color:var(--indigo)}
.hp-pay-card h3{font-size:22px;font-weight:900;margin-top:16px;line-height:1.4}
.hp-pay-card p{margin-top:10px;font-size:14px;color:var(--slate);line-height:1.78}
.hp-pay-list{display:grid;gap:10px;margin-top:18px}
.hp-pay-li{display:grid;grid-template-columns:20px minmax(0,1fr);gap:10px;font-size:13.5px;line-height:1.65;color:#5c554e}
.hp-pay-li em{font-style:normal;font-weight:900;color:var(--green-d)}
.hp-pay-card.hp-soon .hp-pay-li em{color:var(--indigo)}

/* ── 常見問題 ─────────────────────────────── */
.hp-faq{background:var(--cream)}
.hp-faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:30px}
.hp-faq-card{border:1px solid var(--line);border-radius:20px;padding:24px;background:var(--shell);display:flex;flex-direction:column;height:100%}
.hp-faq-q{display:grid;grid-template-columns:26px minmax(0,1fr);gap:11px;align-items:start}
.hp-faq-q span{
  width:26px;height:26px;border-radius:999px;background:linear-gradient(135deg,var(--blue),var(--cyan));color:#fff;
  display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;flex:none;
}
.hp-faq-q b{font-size:15.5px;font-weight:900;line-height:1.5}
.hp-faq-card p{margin-top:12px;font-size:13.5px;color:var(--slate);line-height:1.78}
.hp-faq-tiers{margin-top:14px;border:1px solid var(--line);border-radius:14px;background:var(--sand);overflow:hidden}
.hp-faq-tier{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 15px;font-size:13px}
.hp-faq-tier+.hp-faq-tier{border-top:1px solid var(--line)}
.hp-faq-tier span{color:var(--ink2);font-weight:700}
.hp-faq-tier b{color:var(--green-d);font-weight:900;font-variant-numeric:tabular-nums;white-space:nowrap}

/* ── 教學影片 ─────────────────────────────── */
.hp-vids{background:linear-gradient(180deg,#f9f7f2,#fdfbf8)}
.hp-vid-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:26px}
.hp-vid-card{border:1px solid var(--line);border-radius:22px;padding:16px;background:var(--shell)}
.hp-vid-thumb{
  border-radius:16px;background:linear-gradient(135deg,#eef4fd,#eef8f3,#fdf1e6);height:190px;display:flex;
  flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--ink);
}
.hp-vid-play{
  width:54px;height:54px;border-radius:999px;background:var(--cta);display:flex;align-items:center;
  justify-content:center;font-size:20px;color:#fff;box-shadow:0 10px 24px rgba(240,150,122,.3);
  transition:transform .34s cubic-bezier(.22,1,.36,1);
}
.hp-vid-card:hover .hp-vid-play{transform:scale(1.12)}
.hp-vid-thumb b{font-size:14px;font-weight:900}
.hp-vid-card .hp-h3{margin-top:14px;font-size:16px}
.hp-vid-card p{margin-top:6px;font-size:13.5px;color:var(--slate);line-height:1.65}

/* ── 聯絡 / FOOTER（改淺色） ───────────────── */
.hp-contact{background:var(--cream)}
.hp-contact-box{
  border:1px solid var(--line);border-radius:34px;padding:44px;
  background:radial-gradient(circle at 12% 10%,rgba(95,143,212,.07),transparent 34%),
             radial-gradient(circle at 88% 86%,rgba(104,189,148,.07),transparent 34%),#fffdfa;
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:44px;align-items:center;
  box-shadow:0 26px 70px rgba(61,56,51,.07);
}
.hp-qr-big{
  width:236px;height:236px;border-radius:26px;border:1px solid var(--line);background:var(--shell);padding:16px;
  box-shadow:0 18px 40px rgba(61,56,51,.09);
  display:flex;align-items:center;justify-content:center;
}
.hp-qr-big .hp-qr-grid{width:100%;height:100%;border-radius:14px}
.hp-qr-grid{background:
  linear-gradient(90deg,#cfc4b4 25%,transparent 25%,transparent 75%,#cfc4b4 75%),
  linear-gradient(180deg,#cfc4b4 25%,transparent 25%,transparent 75%,#cfc4b4 75%);
  background-size:16px 16px;background-color:#fbf8f3;}
.hp-footer{background:var(--sand);color:var(--slate);border-top:1px solid var(--line)}
.hp-foot-in{padding:34px 0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;align-items:center}
.hp-foot-brand{display:flex;align-items:center;gap:12px}
.hp-foot-brand b{color:var(--ink);font-size:15px;font-weight:900;display:block}
.hp-foot-brand span{font-size:11px;letter-spacing:.14em;color:var(--mute)}
.hp-foot-links{display:flex;gap:22px;font-size:13px;font-weight:800}
.hp-foot-links a{color:#6b635b;text-decoration:none;transition:color .25s ease}
.hp-foot-links a:hover{color:var(--blue-d)}
.hp-foot-bottom{border-top:1px solid var(--line)}
.hp-foot-bottom-in{padding:16px 0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;font-size:12px;color:var(--mute)}

/* ── 標註（設計註解，實作時刪除） ───────────── */

/* ── 實作用：滿版破解 layout 的 max-w-4xl 限制 ── */
.hp-bleed{width:100vw;position:relative;left:50%;margin-left:-50vw;}
.hp-sec{padding:76px 0;border-bottom:1px solid var(--line);}
.hp-sec.hp-nav,.hp-sec.hp-hero{padding:0;}

/* ══════════════════════════════════════════════
   響應式（RWD）
   設計稿為 1440 固定畫布，以下為實作用的自適應規則
   斷點：1024 平板 / 768 手機 / 480 細機
   ══════════════════════════════════════════════ */

/* ── 平板（≤1024）────────────────────────────── */
@media (max-width:1024px){
  .hp-wrap{padding:0 20px}
  .hp-sec{padding:60px 0}

  /* 導覽：收起中間選單，只留品牌 + CTA */
  .hp-navmenu{display:none}
  .hp-nav-in{grid-template-columns:minmax(0,1fr) auto;gap:14px}

  /* Hero：改單欄，手機示意圖放下面 */
  .hp-hero-in{grid-template-columns:minmax(0,1fr);gap:36px;padding:44px 0 54px}
  .hp-hero h1{font-size:44px}
  .hp-hero-lead{max-width:none}
  .hp-hero-side{order:2}
  .hp-hero-side-note{margin-top:12px}

  /* 多欄 grid 一律降為 2 欄 */
  .hp-grid3,.hp-grid4,.hp-mer-grid,.hp-pr-grid,.hp-hw-grid,
  .hp-onl-grid,.hp-rep-grid,.hp-plans{grid-template-columns:repeat(2,minmax(0,1fr))}

  /* 橫向兩欄區塊改單欄 */
  .hp-why{grid-template-columns:minmax(0,1fr);gap:24px;padding:28px}
  .hp-show-item{grid-template-columns:minmax(0,1fr);gap:26px;padding:34px 0}
  .hp-scan-wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .hp-contact-box{grid-template-columns:minmax(0,1fr);gap:28px;padding:32px}

  /* 條狀區塊：文字在上、按鈕在右下，改為堆疊 */
  .hp-cust-strip,.hp-mer-foot,.hp-callout,.hp-hw-strip{
    grid-template-columns:minmax(0,1fr);gap:16px;padding:20px 22px;
  }
  .hp-cust-strip .hp-btn,.hp-mer-foot .hp-btn,.hp-hw-strip .hp-btn{justify-self:start}
  .hp-callout-quote{white-space:normal;text-align:left}

  /* 五步流程：3 + 2 換行 */
  .hp-flowline{grid-template-columns:repeat(3,minmax(0,1fr))}

  .hp-h2{font-size:32px}
  .hp-lane-head{grid-template-columns:minmax(0,1fr);gap:14px;align-items:start}
}

/* ── 手機（≤768）──────────────────────────────── */
@media (max-width:768px){
  .hp-wrap{padding:0 18px}
  .hp-sec{padding:48px 0}

  .hp-h2{font-size:26px;line-height:1.25}
  .hp-lead{font-size:15px;line-height:1.72}
  .hp-eyebrow{font-size:11px;padding:7px 13px}

  /* 導覽：品牌縮細，CTA 縮短 */
  .hp-brand-mark{width:38px;height:38px;border-radius:12px;font-size:17px}
  .hp-brand-t{font-size:15px}
  .hp-brand-s{font-size:9px;letter-spacing:.12em}
  .hp-nav-in{padding:10px 0}
  .hp-nav-in .hp-btn{padding:10px 14px;font-size:13px;border-radius:12px}

  /* Hero */
  .hp-hero-in{padding:32px 0 44px;gap:28px}
  .hp-hero h1{font-size:32px;line-height:1.16;margin-top:16px}
  .hp-hero-lead{font-size:15px;margin-top:14px}
  .hp-hero-cta{gap:10px;margin-top:20px}
  .hp-hero-cta .hp-btn{flex:1 1 100%;padding:14px 20px}

  /* 手機示意圖：縮細免壓爆 */
  .hp-phone{width:210px}
  .hp-phone-scr{height:400px}

  /* 指標卡：2×2，唔再壓成直條 */
  .hp-metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:20px}
  .hp-metric{padding:12px}
  .hp-metric b{font-size:14px}
  .hp-metric span{font-size:11px}

  /* slogan：橫向可讀 */
  .hp-slogan{padding:11px 14px;font-size:13.5px}

  /* 一般卡片 */
  .hp-card{border-radius:18px;padding:20px}
  .hp-choose-card{border-radius:22px;padding:24px}
  .hp-choose-card h3{font-size:23px}
  .hp-choose-cta{flex-direction:column}
  .hp-choose-cta .hp-btn{width:100%}

  /* 所有多欄 → 單欄 */
  .hp-grid2,.hp-grid3,.hp-grid4,
  .hp-mer-grid,.hp-pr-grid,.hp-hw-grid,.hp-onl-grid,.hp-rep-grid,
  .hp-plans,.hp-pay-grid,.hp-faq-grid,.hp-vid-grid,
  .hp-kds-cols,.hp-scan-wrap{grid-template-columns:minmax(0,1fr)}

  /* 商家業態分頁：可橫向捲動，唔壓爆 */
  .hp-bizline{gap:8px;margin:20px 0;overflow-x:auto;padding-bottom:4px;-webkit-overflow-scrolling:touch}
  .hp-biztab{flex:none;padding:11px 16px;font-size:13.5px}

  /* 方案卡：單欄後唔需要 min-height 撐齊 */
  .hp-plan{padding:22px 18px}
  .hp-plan-sub{min-height:0}
  .hp-plan-price b{font-size:30px}
  .hp-plan-tag{left:18px}

  /* 定價對比 */
  .hp-why{padding:22px;border-radius:20px}
  .hp-why h3{font-size:20px}
  .hp-why-box{padding:14px 16px;font-size:13px}

  /* Showcase */
  .hp-show-item{padding:28px 0;gap:20px}
  .hp-show-item h3{font-size:24px}
  .hp-show-item p{font-size:14.5px}
  .hp-showcmp{flex-direction:column;gap:9px}

  /* KDS / 掃碼示意 */
  .hp-mock-frame{padding:12px}
  .hp-kds-cols{gap:9px}
  .hp-scan-card,.hp-scanpay{padding:16px}

  /* 流程圖：2 欄 */
  .hp-flowline{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  /* 最後一個（第 5 個）單獨佔滿，避免落單 */
  .hp-flow:last-child{grid-column:1/-1}

  /* 按鈕唔好爆格 */
  .hp-btn{padding:13px 20px;font-size:14px;border-radius:14px}

  /* 教學影片縮圖 */
  .hp-vid-thumb{height:170px}

  /* 聯絡區：二維碼縮細、置中 */
  .hp-contact-box{padding:24px 20px;border-radius:24px;gap:24px}
  .hp-qr-big{width:190px;height:190px;padding:13px;margin:0 auto}

  /* Footer 堆疊 */
  .hp-foot-in,.hp-foot-bottom-in{grid-template-columns:minmax(0,1fr);gap:14px;padding:24px 0}
  .hp-foot-links{flex-wrap:wrap;gap:14px}

  /* FAQ 月費階梯：窄螢幕改上下排 */
  .hp-faq-tier{flex-direction:column;align-items:flex-start;gap:2px}
  .hp-faq-tier b{font-size:13.5px}
}

/* ── 細機（≤480）──────────────────────────────── */
@media (max-width:480px){
  .hp-wrap{padding:0 16px}
  .hp-sec{padding:42px 0}

  .hp-h2{font-size:23px}
  .hp-hero h1{font-size:28px}
  .hp-hero-lead{font-size:14.5px}
  .hp-choose-card h3{font-size:21px}
  .hp-show-item h3{font-size:21px}
  .hp-pay-card h3{font-size:19px}
  .hp-why h3{font-size:18px}

  .hp-card,.hp-cust-card,.hp-mer-card,.hp-pr-card,.hp-hw-card,
  .hp-onl-card,.hp-rep-card,.hp-faq-card,.hp-pay-card{padding:18px}

  .hp-phone{width:186px}
  .hp-phone-scr{height:362px}
  .hp-metrics{grid-template-columns:minmax(0,1fr)}
  .hp-flowline{grid-template-columns:minmax(0,1fr)}
  .hp-flow:last-child{grid-column:auto}

  .hp-qr-big{width:168px;height:168px}
  .hp-brand-t{font-size:14px}
}

/* 尊重「減少動態效果」系統設定 */
@media (prefers-reduced-motion:reduce){
  .hp-root *,.hp-root *::before,.hp-root *::after{
    animation-duration:.001ms!important;animation-iteration-count:1!important;
    transition-duration:.001ms!important;scroll-behavior:auto!important;
  }
}
